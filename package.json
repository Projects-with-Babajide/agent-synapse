{
  "name": "agent-synapse",
  "version": "0.2.0",
  "description": "Cross-project messaging between Claude Code sessions via named agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-synapse": "./dist/cli.js"
  },
